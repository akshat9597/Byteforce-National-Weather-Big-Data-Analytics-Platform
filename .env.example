# Local development defaults; choose your own secrets before starting Docker.
BOOTSTRAP_PASSWORD=replace-with-a-long-unique-password
JWT_SECRET=replace-with-at-least-32-random-characters
POSTGRES_PASSWORD=replace-with-a-url-safe-database-password
DATABASE_URL=sqlite:///./byteforce.db
SIMULATE_FEED=true
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
UPLOAD_DIR=uploads
# REDIS_URL=redis://localhost:6379/0
# APP_ENV=production  # requires HTTPS and sets Secure session cookies

# Email OTP: independent secret (at least 32 random characters).
OTP_HASH_SECRET=replace-with-an-independent-long-random-secret
# Local inbox: python scripts/dev_mail.py (requires requirements-dev.txt)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_FROM=no-reply@byteforce.local
# Production: verified sender, SMTP_SECURITY=starttls (587) or ssl (465).
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Choose smtp (local inbox) or resend (HTTPS email API).
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM="BYTEFORCE <onboarding@resend.dev>"
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=45
